# ── Dependencies ──
node_modules/

# ── Build artifacts (generated by esbuild; distributed via GitHub Releases) ──
# main.js / main.css 是 esbuild 产物；styles.css 是 esbuild 从源码 src/*.css 打包后的
# 同名输出（Obsidian 只自动加载插件根目录 styles.css），故此处放行，由仓库追踪源码版。
main.js
main.css
lib/

# ── Obsidian plugin data (NEVER commit user data / credentials) ──
data.json
.obsidian/

# ── Environment / secrets ──
.env
.env.*
*.local

# ── Test artifacts ──
node_modules/.vitest/
*.timestamp-*.mjs

# ── OS / editor noise ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Backup / temp ──
*.bak
*.log
*.tmp

# ── WorkBuddy local memory (not project source) ──
.workbuddy/
