# ── Dependencies ──
node_modules/

# ── Build artifacts ──
# main.css 是 esbuild 中间产物（会被复制为 styles.css 后删除），不追踪。
# main.js / styles.css 作为「已构建产物」直接提交进仓库，由 Release 直接取用（不重新构建）。
main.css
lib/

# ── Obsidian plugin data (NEVER commit user data / credentials) ──
data.json
.obsidian/

# ── Environment / secrets ──
.env
.env.*
*.local

# ── Test artifacts ──
node_modules/.vitest/
*.timestamp-*.mjs

# ── OS / editor noise ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Backup / temp ──
*.bak
*.log
*.tmp

# ── WorkBuddy local memory (not project source) ──
.workbuddy/
