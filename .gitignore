# ── Dependencies ──
node_modules/

# ── Build artifacts (generated by esbuild; distributed via GitHub Releases) ──
# main.js / main.css / styles.css 均为 esbuild 产物；样式源码在 src/styles.css，
# 根目录 styles.css 仅作 Obsidian 加载的构建产物，不再纳入版本控制。
main.js
main.css
/styles.css
lib/

# ── Obsidian plugin data (NEVER commit user data / credentials) ──
data.json
.obsidian/

# ── Environment / secrets ──
.env
.env.*
*.local

# ── Test artifacts ──
node_modules/.vitest/
*.timestamp-*.mjs

# ── OS / editor noise ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Backup / temp ──
*.bak
*.log
*.tmp

# ── WorkBuddy local memory (not project source) ──
.workbuddy/
